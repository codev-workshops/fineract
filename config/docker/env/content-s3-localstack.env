#
# Points the document content store at the LocalStack S3 emulation, mirroring
# how the ECS deployment is configured: the access/secret keys stay blank so
# that the AWS SDK falls back to its default credential chain, which is the
# task role on ECS and the shared credentials file here.

FINERACT_CONTENT_FILESYSTEM_ENABLED=false
FINERACT_CONTENT_S3_ENABLED=true
FINERACT_CONTENT_S3_BUCKET_NAME=fineract-content
FINERACT_CONTENT_S3_REGION=us-east-1
FINERACT_CONTENT_S3_ENDPOINT=http://localstack:4566
FINERACT_CONTENT_S3_PATH_STYLE_ADDRESSING_ENABLED=true
FINERACT_CONTENT_S3_ACCESS_KEY=
FINERACT_CONTENT_S3_SECRET_KEY=

AWS_EC2_METADATA_DISABLED=true
AWS_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=/etc/aws/credentials
AWS_PROFILE=default
