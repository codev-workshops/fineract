#
# Read-only tenant datasource. The read instance mode routes its queries here,
# so the tenant row has to carry these details; they are written when the
# tenant is created, which means the write (migration) service needs them too.
#
# In AWS this points at the Aurora reader endpoint. Locally there is only one
# PostgreSQL, so it points back at the same server.

FINERACT_DEFAULT_TENANTDB_RO_HOSTNAME=db
FINERACT_DEFAULT_TENANTDB_RO_PORT=5432
FINERACT_DEFAULT_TENANTDB_RO_UID=postgres
FINERACT_DEFAULT_TENANTDB_RO_NAME=fineract_default
