# Local development environment for running Fineract against the local Docker services.
# Usage: set -a && source local-dev.env && set +a && ./gradlew :fineract-provider:bootRun
export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# PostgreSQL (docker container "fineract-postgres")
export FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
export FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://localhost:5432/fineract_tenants
export FINERACT_HIKARI_USERNAME=root
export FINERACT_HIKARI_PASSWORD=postgres
export FINERACT_DEFAULT_TENANTDB_HOSTNAME=localhost
export FINERACT_DEFAULT_TENANTDB_PORT=5432
export FINERACT_DEFAULT_TENANTDB_UID=root
export FINERACT_DEFAULT_TENANTDB_PWD=postgres
export FINERACT_DEFAULT_TENANTDB_NAME=fineract_default
export FINERACT_DEFAULT_TENANTDB_IDENTIFIER=default
export FINERACT_DEFAULT_TENANTDB_TIMEZONE=Asia/Kolkata

# Sample/demo data and dev-friendly defaults
export SPRING_PROFILES_ACTIVE=test,diagnostics
export FINERACT_INSECURE_HTTP_CLIENT=true
export FINERACT_SERVER_SSL_ENABLED=true

# Mocked external systems
# S3 (report export) -> LocalStack
export AWS_ENDPOINT_URL=http://localhost:4566
export AWS_ACCESS_KEY_ID=localstack
export AWS_SECRET_ACCESS_KEY=localstack
export AWS_REGION=us-east-1
export FINERACT_REPORT_EXPORT_S3_ENABLED=true
export FINERACT_REPORT_EXPORT_S3_BUCKET_NAME=fineract-reports
# OAuth2 issuer -> mock-oauth2-server (only used when oauth2 security is enabled)
export FINERACT_SECURITY_OAUTH_RESOURCE_URL=http://localhost:9000/auth/realms/fineract
