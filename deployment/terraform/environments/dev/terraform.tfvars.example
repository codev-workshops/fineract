# Copy to terraform.tfvars and adjust. Never put secret values in here: every
# password lives in Secrets Manager and is generated by Terraform.

project     = "fineract"
environment = "dev"
region      = "eu-central-1"

availability_zones  = ["eu-central-1a", "eu-central-1b", "eu-central-1c"]
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24", "10.20.2.0/24"]
app_subnet_cidrs    = ["10.20.10.0/24", "10.20.11.0/24", "10.20.12.0/24"]
data_subnet_cidrs   = ["10.20.20.0/24", "10.20.21.0/24", "10.20.22.0/24"]

# Restrict this to the office/VPN ranges outside a sandbox.
alb_ingress_cidrs = ["0.0.0.0/0"]

# Image pushed to the ECR repository this stack creates.
image           = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/fineract:latest"
certificate_arn = "arn:aws:acm:eu-central-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# The read instance mode only makes sense once the read-only tenant datasource
# has been verified against the Aurora reader endpoint.
enable_read_service = false

broker_type = "msk"

# Sizing suitable for a development environment.
write_min_capacity  = 2
write_max_capacity  = 4
worker_min_capacity = 2
worker_max_capacity = 6
db_instance_class   = "db.t4g.medium"
db_instance_count   = 2
msk_instance_type   = "kafka.t3.small"

# Development conveniences; leave them off in production.
db_deletion_protection         = false
db_skip_final_snapshot         = true
content_bucket_force_destroy   = true
secret_recovery_window_in_days = 0
enable_execute_command         = true

tags = {
  Owner = "platform"
}
